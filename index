        const obj = getSelectedObject();
        if (obj && AppState.selectedIsZone) {
          obj.type = e.target.value;
          renderZonesForPage(AppState.selectedItemPage);
          updateInspectorUI();
        }
      });

      document.getElementById('propZoneRows').addEventListener('input', (e) => {
        const obj = getSelectedObject();
        if (obj && AppState.selectedIsZone) {
          obj.rows = Math.max(1, parseInt(e.target.value, 10) || 2);
          renderZonesForPage(AppState.selectedItemPage);
        }
      });

      document.getElementById('propZoneCols').addEventListener('input', (e) => {
        const obj = getSelectedObject();
        if (obj && AppState.selectedIsZone) {
          obj.cols = Math.max(1, parseInt(e.target.value, 10) || 2);
          renderZonesForPage(AppState.selectedItemPage);
        }
      });

      document.getElementById('btnAutoDetectTableGrid').addEventListener('click', () => {
        const obj = getSelectedObject();
        if (obj && AppState.selectedIsZone && obj.type === 'table') {
          const est = estimateTableRowsAndColsFromCanvas(AppState.selectedItemPage, obj.x, obj.y, obj.width, obj.height);
          obj.rows = est.rows;
          obj.cols = est.cols;
          document.getElementById('propZoneRows').value = obj.rows;
          document.getElementById('propZoneCols').value = obj.cols;
          renderZonesForPage(AppState.selectedItemPage);
          showToast(`Tabla detectada: ${obj.rows} filas × ${obj.cols} columnas.`, 'success');
        }
      });

      document.getElementById('btnReplicateAllPages').addEventListener('click', () => {
        const obj = getSelectedObject();
        if (!obj) return;
        for (let p = 1; p <= AppState.numPages; p++) {
          if (p === AppState.selectedItemPage) continue;
          const clone = JSON.parse(JSON.stringify(obj));
          clone.id = `${obj.type}_rep_${p}_${Date.now()}`;
          if (AppState.selectedIsZone) {
            AppState.zonesByPage[p].push(clone);
            renderZonesForPage(p);
          } else {
            AppState.overlaysByPage[p].push(clone);
            renderOverlayItemsForPage(p);
          }
        }
        showToast(`Elemento repetido en las ${AppState.numPages} páginas.`, 'success');
      });

      document.getElementById('btnDeleteSelectedItem').addEventListener('click', () => {
        if (AppState.selectedItemId && AppState.selectedItemPage) {
          deleteItemById(AppState.selectedItemId, AppState.selectedItemPage, AppState.selectedIsZone);
        }
      });

      // 8. Modal Estudio de Firmas Pro
      const sigModal = document.getElementById('signatureStudioModal');
      const openSigStudio = () => {
        sigModal.classList.remove('hidden');
        sigModal.classList.add('flex');
        document.getElementById('previewProfileDate').textContent = new Date().toLocaleString('es-MX');
      };
      document.getElementById('btnOpenSignatureStudio').addEventListener('click', openSigStudio);
      document.getElementById('btnQuickOpenSigModal').addEventListener('click', openSigStudio);
      document.getElementById('btnNewStampProfile').addEventListener('click', () => {
        openSigStudio();
        switchSignatureTab('profile');
      });
      document.getElementById('btnCloseSignatureStudio').addEventListener('click', () => {
        sigModal.classList.add('hidden');
        sigModal.classList.remove('flex');
      });

      document.querySelectorAll('.sig-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => switchSignatureTab(btn.dataset.sigtab));
      });

      document.querySelectorAll('.ink-color-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          AppState.activeInkColor = btn.dataset.ink;
          document.querySelectorAll('.ink-color-btn').forEach((b) => b.classList.remove('ring-2', 'ring-offset-2', 'ring-indigo-500'));
          btn.classList.add('ring-2', 'ring-offset-2', 'ring-indigo-500');
        });
      });

      document.getElementById('btnClearSigPad').addEventListener('click', clearSignaturePad);

      document.getElementById('btnSaveSigFromPad').addEventListener('click', () => {
        const canvas = document.getElementById('signaturePadCanvas');
        const dataUrl = canvas.toDataURL('image/png');
        const name = (document.getElementById('sigCustomName').value || 'Firma 3x').trim();
        const sigObj = { id: 'sig_' + Date.now(), name, dataUrl };
        AppState.savedSignatures.unshift(sigObj);
        safeStorageSet('docuvision_signatures_v6', AppState.savedSignatures);
        renderSavedSignaturesSidebar();
        insertSignatureOrStampOnPage(dataUrl, 'signature', AppState.activePage);
        sigModal.classList.add('hidden');
        sigModal.classList.remove('flex');
        showToast(`Firma "${name}" insertada en Página ${AppState.activePage}.`, 'success');
      });

      const sigPhotoInput = document.getElementById('sigPhotoInput');
      document.getElementById('btnUploadSigPhoto').addEventListener('click', () => sigPhotoInput.click());
      sigPhotoInput.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => {
            const c = document.createElement('canvas');
            c.width = Math.min(600, img.width);
            c.height = Math.round((c.width / img.width) * img.height);
            c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
            rawExtractorSourceCanvas = c;
            processSignaturePhotoExtraction();
          };
          img.src = reader.result;
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('btnLoadSamplePaperSig').addEventListener('click', loadSamplePaperSignatureIntoExtractor);

      const lumSlider = document.getElementById('sigLumToleranceSlider');
      lumSlider.addEventListener('input', () => {
        document.getElementById('sigLumToleranceVal').textContent = lumSlider.value;
        processSignaturePhotoExtraction();
      });

      document.getElementById('btnSaveExtractedSig').addEventListener('click', () => {
        if (!AppState.extractedSigDataUrl) {
          loadSamplePaperSignatureIntoExtractor();
        }
        const sigObj = {
          id: 'sig_ext_' + Date.now(),
          name: 'Sello/Firma Extraída',
          dataUrl: AppState.extractedSigDataUrl
        };
        AppState.savedSignatures.unshift(sigObj);
        safeStorageSet('docuvision_signatures_v6', AppState.savedSignatures);
        renderSavedSignaturesSidebar();
        insertSignatureOrStampOnPage(sigObj.dataUrl, 'signature', AppState.activePage);
        sigModal.classList.add('hidden');
        sigModal.classList.remove('flex');
        showToast('Firma extraída e insertada en la hoja.', 'success');
      });

      document.getElementById('profileSignerName').addEventListener('input', (e) => {
        document.getElementById('previewProfileName').textContent = e.target.value;
      });
      document.getElementById('profileSignerRole').addEventListener('input', (e) => {
        document.getElementById('previewProfileRole').textContent = e.target.value;
      });
      document.getElementById('btnCreateStampProfileModal').addEventListener('click', () => {
        const name = (document.getElementById('profileSignerName').value || 'Firmante').trim();
        const role = (document.getElementById('profileSignerRole').value || 'Cargo').trim();
        const includeDate = document.getElementById('profileIncludeDate').checked;
        const sigDataUrl = AppState.savedSignatures[0]?.dataUrl || createDefaultSignatureDataUrl();

        const newProf = { id: 'prof_' + Date.now(), name, role, includeDate, sigDataUrl };
        AppState.stampProfiles.unshift(newProf);
        safeStorageSet('docuvision_profiles_v6', AppState.stampProfiles);
        renderStampProfilesSidebar();
        showToast(`Perfil "${name}" guardado.`, 'success');
      });

      // 9. Modal Conversor a .DOCX
      const docxModal = document.getElementById('docxInspectorModal');
      document.getElementById('btnOpenDocxModal').addEventListener('click', async () => {
        docxModal.classList.remove('hidden');
        docxModal.classList.add('flex');
        await buildDocxInspectionPreview(false);
      });
      document.getElementById('btnCloseDocxModal').addEventListener('click', () => {
        docxModal.classList.add('hidden');
        docxModal.classList.remove('flex');
      });
      document.getElementById('btnForceOcrForDocx').addEventListener('click', async () => {
        await buildDocxInspectionPreview(true);
      });
      document.getElementById('btnDownloadDocxNow').addEventListener('click', async () => {
        await compileAndDownloadDocxFile();
      });

      document.getElementById('btnActivateManualZoneEditor').addEventListener('click', () => {
        docxModal.classList.add('hidden');
        docxModal.classList.remove('flex');
        document.getElementById('zoneEditorBanner').classList.remove('hidden');
        setActiveTool('zone-table');
        if ((AppState.zonesByPage[AppState.activePage] || []).length === 0) {
          autoSuggestZonesOnActivePage();
        }
        showToast('Modo Zonas activado. Ajusta los recuadros de colores o dibuja nuevos.', 'info');
      });

      document.getElementById('btnAutoDetectZonesOnPage').addEventListener('click', autoSuggestZonesOnActivePage);
      document.getElementById('btnClearZonesOnPage').addEventListener('click', () => {
        AppState.zonesByPage[AppState.activePage] = [];
        renderZonesForPage(AppState.activePage);
        showToast(`Zonas limpiadas en Página ${AppState.activePage}.`, 'info');
      });
      document.getElementById('btnLogZoneCaseOneClick').addEventListener('click', logManualZoneCaseOneClick);
      document.getElementById('btnCompileZonesToDocx').addEventListener('click', async () => {
        await buildDocxInspectionPreview(false);
        await compileAndDownloadDocxFile();
      });

      // 10. Modal Exportación PDF y Blindaje
      const exportModal = document.getElementById('exportPdfModal');
      const closeExp = () => {
        exportModal.classList.add('hidden');
        exportModal.classList.remove('flex');
      };
      document.getElementById('btnOpenExportModal').addEventListener('click', () => {
        exportModal.classList.remove('hidden');
        exportModal.classList.add('flex');
      });
      document.getElementById('btnCloseExportModal').addEventListener('click', closeExp);
      document.getElementById('btnCancelExportModal').addEventListener('click', closeExp);
      document.getElementById('btnConfirmExportPdf').addEventListener('click', async () => {
        closeExp();
        await exportFinalPdfDocument();
      });

      // 11. Modal Bitácora de Auditoría y Prompt IA
      const auditModal = document.getElementById('auditLogModal');
      document.getElementById('btnOpenAuditLog').addEventListener('click', () => {
        auditModal.classList.remove('hidden');
        auditModal.classList.add('flex');
        renderAuditLogUI();
      });
      document.getElementById('btnCloseAuditModal').addEventListener('click', () => {
        auditModal.classList.add('hidden');
        auditModal.classList.remove('flex');
      });

      document.getElementById('btnAddAuditEntry').addEventListener('click', () => {
        const cat = document.getElementById('auditCategorySelect').value;
        const descInput = document.getElementById('auditDescriptionInput');
        const desc = descInput.value.trim();
        if (!desc) {
          showToast('Escribe una nota antes de guardar.', 'warn');
          return;
        }
        addAuditLogEntry(cat, desc, AppState.fileName);
        descInput.value = '';
        showToast('Nota registrada en la Bitácora.', 'success');
      });

      document.getElementById('btnExportAuditJson').addEventListener('click', () => {
        const jsonStr = JSON.stringify(AppState.auditLog, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8' });
        window.saveAs(blob, 'Bitacora_DocuVision_Pro.json');
        showToast('Respaldo .JSON descargado.', 'success');
      });

      const auditImportInput = document.getElementById('auditJsonImportInput');
      document.getElementById('btnImportAuditJson').addEventListener('click', () => auditImportInput.click());
      auditImportInput.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const parsed = JSON.parse(reader.result);
            if (Array.isArray(parsed)) {
              AppState.auditLog = parsed;
              saveAuditLogToStorage();
              showToast(`Se importaron ${parsed.length} registros.`, 'success');
            }
          } catch (err) {
            showToast('Archivo JSON inválido.', 'error');
          }
        };
        reader.readAsText(file);
      });

      document.getElementById('btnGenerateAiPrompt').addEventListener('click', generateAiImprovementPrompt);
    }

    function switchSignatureTab(tabId) {
      const map = { pad: 'sigTabPad', extractor: 'sigTabExtractor', profile: 'sigTabProfile' };
      Object.values(map).forEach((id) => document.getElementById(id).classList.add('hidden'));
      document.getElementById(map[tabId]).classList.remove('hidden');

      document.querySelectorAll('.sig-tab-btn').forEach((btn) => {
        if (btn.dataset.sigtab === tabId) {
          btn.className = 'sig-tab-btn px-3 py-2 text-xs font-semibold border-b-2 border-indigo-500 text-indigo-600 dark:text-indigo-400';
        } else {
          btn.className = 'sig-tab-btn px-3 py-2 text-xs font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300';
        }
      });

      if (tabId === 'extractor' && !rawExtractorSourceCanvas) {
        loadSamplePaperSignatureIntoExtractor();
      }
    }

    // ==================== INICIALIZACIÓN AL CARGAR LA VENTANA ====================
    window.addEventListener('DOMContentLoaded', async () => {
      if (window.lucide) window.lucide.createIcons();
      initSignaturePad();
      initSavedSignaturesAndProfiles();
      loadAuditLogFromStorage();
      wireAllEventListeners();

      // Mostrar u ocultar tutorial inicial según preferencia del usuario
      const hideTutorial = safeStorageGet('docuvision_hide_tutorial_v6', false);
      if (hideTutorial) {
        document.getElementById('welcomeTutorialModal').classList.add('hidden');
        document.getElementById('welcomeTutorialModal').classList.remove('flex');
      }

      const demoBytes = await generateDemoPdfDocument();
      await loadPdfBytesIntoWorkspace(demoBytes, 'Contrato_Demo_AcroForm.pdf');
    });
  </script>

</body></html>
