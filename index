    // ==================== MÓDULO 3: ESTUDIO DE FIRMAS PRO, EXTRACTOR DE PAPEL Y PERFILES DE ESTAMPADO ====================

    let sigPadPoints = [];
    let isDrawingSig = false;
    let lastSigPoint = null;
    let lastSigVelocity = 0;

    function initSignaturePad() {
      const canvas = document.getElementById('signaturePadCanvas');
      const ctx = canvas.getContext('2d');

      const dpr = 3;
      const cssW = 760;
      const cssH = 210;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      ctx.scale(dpr, dpr);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      function getCoords(e) {
        const rect = canvas.getBoundingClientRect();
        return {
          x: ((e.clientX - rect.left) / rect.width) * cssW,
          y: ((e.clientY - rect.top) / rect.height) * cssH,
          time: performance.now()
        };
      }

      canvas.addEventListener('pointerdown', (e) => {
        isDrawingSig = true;
        const pt = getCoords(e);
        sigPadPoints = [pt];
        lastSigPoint = pt;
        lastSigVelocity = 0;
        canvas.setPointerCapture(e.pointerId);
      });

      canvas.addEventListener('pointermove', (e) => {
        if (!isDrawingSig) return;
        const pt = getCoords(e);
        sigPadPoints.push(pt);

        if (sigPadPoints.length >= 3) {
          const p0 = sigPadPoints[sigPadPoints.length - 3];
          const p1 = sigPadPoints[sigPadPoints.length - 2];
          const p2 = sigPadPoints[sigPadPoints.length - 1];

          const mid1 = { x: (p0.x + p1.x) / 2, y: (p0.y + p1.y) / 2 };
          const mid2 = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };

          const dist = Math.hypot(p2.x - p1.x, p2.y - p1.y);
          const dt = Math.max(1, p2.time - p1.time);
          const velocity = dist / dt;
          const smoothedVel = lastSigVelocity * 0.7 + velocity * 0.3;
          lastSigVelocity = smoothedVel;

          const baseW = parseFloat(document.getElementById('sigBaseWidthSlider').value) || 3;
          const dynamicWidth = Math.max(baseW * 0.42, Math.min(baseW * 1.45, baseW - smoothedVel * 1.1));

          ctx.beginPath();
          ctx.moveTo(mid1.x, mid1.y);
          ctx.quadraticCurveTo(p1.x, p1.y, mid2.x, mid2.y);
          ctx.strokeStyle = AppState.activeInkColor;
          ctx.lineWidth = dynamicWidth;
          ctx.stroke();
        }
        lastSigPoint = pt;
      });

      canvas.addEventListener('pointerup', (e) => {
        if (!isDrawingSig) return;
        isDrawingSig = false;
        if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
      });
    }

    function clearSignaturePad() {
      const canvas = document.getElementById('signaturePadCanvas');
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.restore();
      sigPadPoints = [];
    }

    function createDefaultSignatureDataUrl() {
      const c = document.createElement('canvas');
      c.width = 600;
      c.height = 210;
      const ctx = c.getContext('2d');
      ctx.strokeStyle = '#1d4ed8';
      ctx.lineWidth = 4.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      ctx.beginPath();
      ctx.moveTo(45, 145);
      ctx.quadraticCurveTo(95, 35, 145, 130);
      ctx.quadraticCurveTo(185, 175, 235, 70);
      ctx.quadraticCurveTo(270, 35, 305, 125);
      ctx.quadraticCurveTo(360, 150, 460, 85);
      ctx.quadraticCurveTo(510, 60, 555, 115);
      ctx.stroke();

      ctx.beginPath();
      ctx.lineWidth = 2.5;
      ctx.moveTo(75, 165);
      ctx.quadraticCurveTo(280, 140, 520, 152);
      ctx.stroke();

      return c.toDataURL('image/png');
    }

    let rawExtractorSourceCanvas = null;

    function loadSamplePaperSignatureIntoExtractor() {
      const src = document.createElement('canvas');
      src.width = 520;
      src.height = 220;
      const ctx = src.getContext('2d');

      const grad = ctx.createLinearGradient(0, 0, 520, 220);
      grad.addColorStop(0, '#e5e7eb');
      grad.addColorStop(0.5, '#f3f4f6');
      grad.addColorStop(1, '#d1d5db');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 520, 220);

      ctx.strokeStyle = '#1e3a8a';
      ctx.lineWidth = 3.5;
      ctx.strokeRect(40, 35, 190, 95);
      ctx.font = 'bold 14px Inter, sans-serif';
      ctx.fillStyle = '#1e3a8a';
      ctx.fillText('SELLO OFICIAL VALIDADO', 52, 62);
      ctx.font = '12px JetBrains Mono, monospace';
      ctx.fillText('FOLIO: CERT-2026-MX', 58, 86);
      ctx.fillText('FIRMA AUTORIZADA', 65, 110);

      ctx.beginPath();
      ctx.lineWidth = 4;
      ctx.moveTo(265, 145);
      ctx.quadraticCurveTo(315, 45, 360, 130);
      ctx.quadraticCurveTo(410, 175, 475, 75);
      ctx.stroke();

      rawExtractorSourceCanvas = src;
      processSignaturePhotoExtraction();
    }

    function processSignaturePhotoExtraction() {
      if (!rawExtractorSourceCanvas) return;
      const target = document.getElementById('sigExtractorCanvas');
      target.width = rawExtractorSourceCanvas.width;
      target.height = rawExtractorSourceCanvas.height;

      const sCtx = rawExtractorSourceCanvas.getContext('2d');
      const tCtx = target.getContext('2d');
      const imgData = sCtx.getImageData(0, 0, target.width, target.height);
      const d = imgData.data;

      const tolerance = parseInt(document.getElementById('sigLumToleranceSlider').value, 10) || 200;

      for (let i = 0; i < d.length; i += 4) {
        if (d[i] > tolerance && d[i + 1] > tolerance && d[i + 2] > tolerance) {
          d[i + 3] = 0;
        } else {
          d[i + 3] = 255;
        }
      }

      tCtx.putImageData(imgData, 0, 0);
      AppState.extractedSigDataUrl = target.toDataURL('image/png');
    }

    function buildStampProfileCompositeDataUrl(profile) {
      return new Promise((resolve) => {
        const c = document.createElement('canvas');
        c.width = 660;
        c.height = 270;
        const ctx = c.getContext('2d');

        ctx.strokeStyle = 'rgba(30, 58, 138, 0.55)';
        ctx.lineWidth = 3;
        ctx.strokeRect(8, 8, c.width - 16, c.height - 16);

        const drawTextFooter = () => {
          ctx.strokeStyle = 'rgba(71, 85, 105, 0.6)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(40, 165);
          ctx.lineTo(c.width - 40, 165);
          ctx.stroke();

          ctx.fillStyle = '#0f172a';
          ctx.font = 'bold 22px Helvetica, Arial, sans-serif';
          ctx.fillText(profile.name || 'Firmante Autorizado', 40, 196);

          ctx.fillStyle = '#334155';
          ctx.font = '18px Helvetica, Arial, sans-serif';
          ctx.fillText(profile.role || 'Cargo Oficial', 40, 222);

          if (profile.includeDate) {
