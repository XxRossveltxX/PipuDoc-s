    // ==================== MÓDULO 2: EDICIÓN INTELIGENTE SOBRE ESCANEOS (SMART PATCH + FILTRO LIMPIADOR) ====================

    function sampleBorderColorFromCanvas(pageNum, domX, domY, domW, domH) {
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      if (!wrapper) return '#ffffff';
      const canvas = wrapper.querySelector('canvas');
      if (!canvas) return '#ffffff';

      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      const ratioX = canvas.width / canvas.clientWidth;
      const ratioY = canvas.height / canvas.clientHeight;

      const cx = Math.max(0, Math.floor(domX * ratioX));
      const cy = Math.max(0, Math.floor(domY * ratioY));
      const cw = Math.min(canvas.width - cx, Math.max(4, Math.floor(domW * ratioX)));
      const ch = Math.min(canvas.height - cy, Math.max(4, Math.floor(domH * ratioY)));

      try {
        const imgData = ctx.getImageData(cx, cy, cw, ch).data;
        let rSum = 0, gSum = 0, bSum = 0, count = 0;
        const borderThickness = Math.max(2, Math.min(6, Math.floor(Math.min(cw, ch) * 0.15)));

        for (let y = 0; y < ch; y++) {
          for (let x = 0; x < cw; x++) {
            const isBorder =
              y < borderThickness ||
              y >= ch - borderThickness ||
              x < borderThickness ||
              x >= cw - borderThickness;
            if (isBorder) {
              const idx = (y * cw + x) * 4;
              rSum += imgData[idx];
              gSum += imgData[idx + 1];
              bSum += imgData[idx + 2];
              count++;
            }
          }
        }

        if (count === 0) return '#ffffff';
        return rgbToHex(Math.round(rSum / count), Math.round(gSum / count), Math.round(bSum / count));
      } catch (e) {
        return '#f8fafc';
      }
    }

    function rgbToHex(r, g, b) {
      return '#' + [r, g, b].map((v) => Math.max(0, Math.min(255, v)).toString(16).padStart(2, '0')).join('');
    }

    function hexToRgbNormalized(hex) {
      const clean = (hex || '#000000').replace('#', '');
      const num = parseInt(clean, 16);
      return {
        r: ((num >> 16) & 255) / 255,
        g: ((num >> 8) & 255) / 255,
        b: (num & 255) / 255
      };
    }

    function applyAdaptiveScanFilterToCanvas(canvas, threshold = 185) {
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imgData.data;

      for (let i = 0; i < data.length; i += 4) {
        const lum = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
        if (lum >= threshold) {
          data[i] = 255;
          data[i + 1] = 255;
          data[i + 2] = 255;
        } else {
          const darkened = Math.max(0, Math.floor((lum / threshold) * 90));
          data[i] = darkened;
          data[i + 1] = darkened;
          data[i + 2] = darkened;
        }
      }

      ctx.putImageData(imgData, 0, 0);
    }

    // ==================== INTERACCIÓN EN OVERLAY-LAYER ====================

    function attachOverlayPointerEvents(overlayEl, pageNum) {
      let isDrawing = false;
      let startX = 0;
      let startY = 0;
      let marqueeEl = null;

      overlayEl.addEventListener('pointerdown', (e) => {
        if (e.target !== overlayEl) return;

        if (AppState.activeTool === 'select') {
          AppState.selectedItemId = null;
          AppState.selectedItemPage = null;
          refreshAllSelectionsUI();
          updateInspectorUI();
          return;
        }

        const rect = overlayEl.getBoundingClientRect();
        startX = e.clientX - rect.left;
        startY = e.clientY - rect.top;

        if (AppState.activeTool === 'text') {
          const newItem = {
            id: 'txt_' + Date.now(),
            type: 'text',
            text: 'Escribe aquí...',
            x: Math.max(8, startX - 10),
            y: Math.max(8, startY - 12),
            width: 170,
            height: 30,
            fontFamily: 'Helvetica',
            fontSize: 13,
            fontWeight: 'normal',
            color: '#1e293b',
            bgColor: 'transparent',
            opacity: 0.92
          };
          AppState.overlaysByPage[pageNum].push(newItem);
          selectItem(newItem.id, pageNum, false);
          renderOverlayItemsForPage(pageNum);
          setActiveTool('select');
          showToast('Texto insertado. Escribe directamente o cámbialo en el panel derecho.', 'info');
          return;
        }

        isDrawing = true;
        marqueeEl = document.createElement('div');
        marqueeEl.className = 'drawing-marquee';
        marqueeEl.style.left = `${startX}px`;
        marqueeEl.style.top = `${startY}px`;
        marqueeEl.style.width = '0px';
        marqueeEl.style.height = '0px';
        overlayEl.appendChild(marqueeEl);
        overlayEl.setPointerCapture(e.pointerId);
      });

      overlayEl.addEventListener('pointermove', (e) => {
        if (!isDrawing || !marqueeEl) return;
        const rect = overlayEl.getBoundingClientRect();
        const currX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
        const currY = Math.max(0, Math.min(rect.height, e.clientY - rect.top));

        marqueeEl.style.left = `${Math.min(startX, currX)}px`;
        marqueeEl.style.top = `${Math.min(startY, currY)}px`;
        marqueeEl.style.width = `${Math.abs(currX - startX)}px`;
        marqueeEl.style.height = `${Math.abs(currY - startY)}px`;
      });

      overlayEl.addEventListener('pointerup', (e) => {
        if (!isDrawing) return;
        isDrawing = false;
        if (overlayEl.hasPointerCapture(e.pointerId)) {
          overlayEl.releasePointerCapture(e.pointerId);
        }

        const rect = overlayEl.getBoundingClientRect();
        const endX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
        const endY = Math.max(0, Math.min(rect.height, e.clientY - rect.top));

        const x = Math.min(startX, endX);
        const y = Math.min(startY, endY);
        const w = Math.max(48, Math.abs(endX - startX));
        const h = Math.max(22, Math.abs(endY - startY));

        if (marqueeEl) {
          marqueeEl.remove();
          marqueeEl = null;
        }

        if (AppState.activeTool === 'patch') {
          const sampledColor = sampleBorderColorFromCanvas(pageNum, x, y, w, h);
          const patchItem = {
            id: 'patch_' + Date.now(),
            type: 'patch',
            text: 'Texto corregido',
            x,
            y,
            width: w,
            height: h,
            fontFamily: 'Helvetica',
            fontSize: 12,
            fontWeight: 'normal',
            color: '#1e293b',
            bgColor: sampledColor,
            opacity: 0.9
          };
          AppState.overlaysByPage[pageNum].push(patchItem);
          selectItem(patchItem.id, pageNum, false);
          renderOverlayItemsForPage(pageNum);
          setActiveTool('select');
          showToast(`Parche creado con el color exacto del papel (${sampledColor}).`, 'success');
          return;
        }

        if (AppState.activeTool.startsWith('zone-')) {
          const zoneKind = AppState.activeTool.replace('zone-', '');
          const newZone = {
            id: 'zone_' + Date.now(),
            type: zoneKind,
            x,
            y,
            width: w,
            height: h,
            rows: 4,
            cols: 3
          };
          if (zoneKind === 'table') {
            const guessed = estimateTableRowsAndColsFromCanvas(pageNum, x, y, w, h);
            newZone.rows = guessed.rows;
            newZone.cols = guessed.cols;
          }
          AppState.zonesByPage[pageNum].push(newZone);
          document.getElementById('zoneEditorBanner').classList.remove('hidden');
          selectItem(newZone.id, pageNum, true);
          renderZonesForPage(pageNum);
          showToast(`Zona [${zoneKind.toUpperCase()}] marcada en Página ${pageNum}.`, 'success');
        }
      });
    }

