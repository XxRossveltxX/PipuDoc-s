    function refreshAllSelectionsUI() {
      document.querySelectorAll('.overlay-item').forEach((el) => el.classList.remove('selected'));
      if (!AppState.selectedItemId) return;
      const pageOverlay = document.querySelector(`.overlay-layer[data-page-number="${AppState.selectedItemPage}"]`);
      if (!pageOverlay) return;

      if (AppState.selectedIsZone) {
        renderZonesForPage(AppState.selectedItemPage);
      } else {
        const match = pageOverlay.querySelector(`.overlay-item[data-item-id="${AppState.selectedItemId}"]`);
        if (match) match.classList.add('selected');
