    async function handleUniversalFilesUpload(fileList) {
      if (!fileList || fileList.length === 0) return;
      const files = Array.from(fileList);
      showToast(`Procesando ${files.length} archivo(s)...`, 'info');

      try {
        const firstFile = files[0];
        const isPdf = firstFile.type === 'application/pdf' || firstFile.name.toLowerCase().endsWith('.pdf');

        if (isPdf && files.length === 1) {
          const arrayBuffer = await firstFile.arrayBuffer();
          await loadPdfBytesIntoWorkspace(new Uint8Array(arrayBuffer), firstFile.name);
          showToast(`PDF "${firstFile.name}" cargado correctamente.`, 'success');
          return;
        }

        const { PDFDocument } = window.PDFLib;
        const mergedPdf = await PDFDocument.create();

        for (const file of files) {
          const ext = file.name.toLowerCase();
          if (file.type === 'application/pdf' || ext.endsWith('.pdf')) {
            const srcBytes = await file.arrayBuffer();
            const srcDoc = await PDFDocument.load(srcBytes);
            const copiedPages = await mergedPdf.copyPages(srcDoc, srcDoc.getPageIndices());
            copiedPages.forEach((p) => mergedPdf.addPage(p));
          } else {
            const imgDataUrl = await convertImageFileToStandardPngDataUrl(file);
            const pngImage = await mergedPdf.embedPng(imgDataUrl);
            const imgDims = pngImage.scale(1);
            const pageWidth = 612;
            const pageHeight = 792;
            const page = mergedPdf.addPage([pageWidth, pageHeight]);
            const scaleFactor = Math.min((pageWidth - 40) / imgDims.width, (pageHeight - 40) / imgDims.height, 1);
            const drawW = imgDims.width * scaleFactor;
            const drawH = imgDims.height * scaleFactor;
            page.drawImage(pngImage, {
              x: (pageWidth - drawW) / 2,
              y: (pageHeight - drawH) / 2,
              width: drawW,
              height: drawH
            });
          }
        }

        const pdfBytes = await mergedPdf.save();
        const labelName = files.length === 1 ? `${files[0].name}.pdf` : `Escaneo_Unificado_${files.length}_pags.pdf`;
        await loadPdfBytesIntoWorkspace(pdfBytes, labelName);
        showToast(`Imágenes convertidas al vuelo a PDF de trabajo (${mergedPdf.getPageCount()} pág).`, 'success');
      } catch (err) {
        console.error(err);
        showToast('Error al procesar el archivo: ' + err.message, 'error');
      }
    }

    function convertImageFileToStandardPngDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => {
            const c = document.createElement('canvas');
            c.width = img.naturalWidth || img.width;
            c.height = img.naturalHeight || img.height;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, c.width, c.height);
            ctx.drawImage(img, 0, 0);
            resolve(c.toDataURL('image/png'));
          };
          img.onerror = reject;
          img.src = reader.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    let pageIntersectionObserver = null;

    async function loadPdfBytesIntoWorkspace(uint8Array, fileName) {
      AppState.pdfBytes = uint8Array;
      AppState.fileName = fileName;
      AppState.renderedPages.clear();
      AppState.originalPageImages = {};
      AppState.cleanedPages = {};
      AppState.overlaysByPage = {};
      AppState.zonesByPage = {};
      AppState.ocrCacheByPage = {};
      AppState.selectedItemId = null;
      AppState.selectedItemPage = null;

      document.getElementById('currentFileLabel').textContent = fileName;
      document.getElementById('exportPdfFilename').value = fileName.replace(/\.pdf$/i, '') + '_Blindado.pdf';

      const loadingTask = window.pdfjsLib.getDocument({ data: uint8Array.slice(0) });
      AppState.pdfJsDoc = await loadingTask.promise;
      AppState.numPages = AppState.pdfJsDoc.numPages;
      AppState.activePage = 1;

      // Calcular escala ideal para que se vea impecable en la pantalla de Chrome
      const firstPage = await AppState.pdfJsDoc.getPage(1);
      const baseVp = firstPage.getViewport({ scale: 1.0 });
      AppState.baseScale = computeOptimalScaleForViewport(baseVp.width, baseVp.height);
      AppState.scale = AppState.baseScale;
      document.getElementById('zoomLabel').textContent = '100%';

      document.getElementById('totalPagesIndicator').textContent = String(AppState.numPages);
      document.getElementById('activePageIndicator').textContent = '1';

      await buildLazyPagePlaceholders();
      updateInspectorUI();
    }

    async function buildLazyPagePlaceholders() {
      const stage = document.getElementById('pagesStage');
      stage.innerHTML = '';

      if (pageIntersectionObserver) {
        pageIntersectionObserver.disconnect();
      }

      const firstPage = await AppState.pdfJsDoc.getPage(1);
      const defaultViewport = firstPage.getViewport({ scale: AppState.scale });

      for (let pageNum = 1; pageNum <= AppState.numPages; pageNum++) {
        if (!AppState.overlaysByPage[pageNum]) AppState.overlaysByPage[pageNum] = [];
        if (!AppState.zonesByPage[pageNum]) AppState.zonesByPage[pageNum] = [];

        const wrapper = document.createElement('div');
        wrapper.className = 'pdf-page-wrapper';
        wrapper.dataset.pageNumber = String(pageNum);
        wrapper.style.width = `${Math.round(defaultViewport.width)}px`;
        wrapper.style.height = `${Math.round(defaultViewport.height)}px`;

        // Etiqueta discreta en esquina superior derecha de la hoja (no se cruza con barras)
        const badge = document.createElement('div');
        badge.className = 'absolute top-2 right-2.5 z-10 px-2 py-0.5 rounded bg-slate-900/65 text-white text-[10px] font-mono pointer-events-none';
        badge.textContent = `Pág. ${pageNum}`;
        wrapper.appendChild(badge);

        const canvas = document.createElement('canvas');
        canvas.className = 'pdf-page-canvas block w-full h-full rounded-[6px]';
        wrapper.appendChild(canvas);

        const overlay = document.createElement('div');
        overlay.className = 'overlay-layer';
        overlay.dataset.pageNumber = String(pageNum);
        attachOverlayPointerEvents(overlay, pageNum);
        wrapper.appendChild(overlay);

        stage.appendChild(wrapper);
      }

      const viewportContainer = document.getElementById('viewportContainer');
      pageIntersectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const pageNum = parseInt(entry.target.dataset.pageNumber, 10);
            if (entry.isIntersecting) {
              AppState.activePage = pageNum;
              document.getElementById('activePageIndicator').textContent = String(pageNum);
              ensurePageWindowRendered(pageNum);
            }
          });
        },
        {
          root: viewportContainer,
          rootMargin: '1400px 0px 1400px 0px',
          threshold: 0.1
        }
      );

      document.querySelectorAll('.pdf-page-wrapper').forEach((el) => {
        pageIntersectionObserver.observe(el);
      });

      await ensurePageWindowRendered(1);
    }

    async function ensurePageWindowRendered(centerPage) {
      const minPage = Math.max(1, centerPage - 2);
      const maxPage = Math.min(AppState.numPages, centerPage + 2);

      for (const renderedPage of Array.from(AppState.renderedPages)) {
        if (renderedPage < minPage || renderedPage > maxPage) {
          releasePageCanvasFromRam(renderedPage);
        }
      }

      for (let p = minPage; p <= maxPage; p++) {
        if (!AppState.renderedPages.has(p)) {
          await renderSinglePdfPage(p);
        }
      }

      updateLazyStatsBadge();
    }

    function releasePageCanvasFromRam(pageNum) {
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      if (!wrapper) return;
      const canvas = wrapper.querySelector('canvas');
      if (canvas) {
        canvas.width = 1;
        canvas.height = 1;
      }
      delete AppState.originalPageImages[pageNum];
      AppState.renderedPages.delete(pageNum);
    }

    function updateLazyStatsBadge() {
      const badge = document.getElementById('lazyStatsBadge');
      if (badge) {
        badge.textContent = `${AppState.renderedPages.size}/${AppState.numPages}`;
      }
    }

    async function renderSinglePdfPage(pageNum) {
      if (!AppState.pdfJsDoc) return;
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      if (!wrapper) return;

      AppState.renderedPages.add(pageNum);
      const page = await AppState.pdfJsDoc.getPage(pageNum);
      const viewport = page.getViewport({ scale: AppState.scale });

      const cssWidth = Math.round(viewport.width);
      const cssHeight = Math.round(viewport.height);
      wrapper.style.width = `${cssWidth}px`;
      wrapper.style.height = `${cssHeight}px`;

      const canvas = wrapper.querySelector('canvas');
      const outputScale = 2;
      canvas.width = cssWidth * outputScale;
      canvas.height = cssHeight * outputScale;
      canvas.style.width = `${cssWidth}px`;
      canvas.style.height = `${cssHeight}px`;

      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      ctx.save();
      ctx.scale(outputScale, outputScale);

      // IMPORTANTE: annotationMode: 0 evita que pdf.js pinte el texto del AcroForm debajo de nuestro input interactivo (elimina las letras encimadas)
      await page.render({
        canvasContext: ctx,
        viewport,
        annotationMode: 0
      }).promise;
      ctx.restore();

      AppState.originalPageImages[pageNum] = ctx.getImageData(0, 0, canvas.width, canvas.height);

      if (AppState.cleanedPages[pageNum]) {
        applyAdaptiveScanFilterToCanvas(canvas, AppState.cleanedPages[pageNum]);
      }

      await detectAndMountAcroForms(page, viewport, pageNum);
      await mountInteractivePdfTextLayer(page, viewport, pageNum);
      renderOverlayItemsForPage(pageNum);
      renderZonesForPage(pageNum);
    }

    async function detectAndMountAcroForms(pdfPage, viewport, pageNum) {
      const existingItems = AppState.overlaysByPage[pageNum] || [];
      const hasAcro = existingItems.some((it) => it.type === 'acroform');

      try {
        const annotations = await pdfPage.getAnnotations();
        let acroCount = 0;

        annotations.forEach((ann) => {
          if (ann.subtype === 'Widget' && ann.rect) {
            const rect = viewport.convertToViewportRectangle(ann.rect);
            const left = Math.min(rect[0], rect[2]);
            const top = Math.min(rect[1], rect[3]);
            const width = Math.abs(rect[2] - rect[0]);
            const height = Math.abs(rect[3] - rect[1]);
            const fName = ann.fieldName || `campo_${acroCount + 1}`;

            const existingField = existingItems.find((it) => it.type === 'acroform' && it.fieldName === fName);
            if (existingField) {
              existingField.x = left;
              existingField.y = top;
              existingField.width = Math.max(width, existingField.fieldType === 'checkbox' ? 16 : 60);
              existingField.height = Math.max(height, 16);
            } else if (!hasAcro) {
              const isCheck = ann.checkBox || ann.fieldType === 'Btn';
              const fallbackVal = DEMO_ACROFORM_DEFAULTS[fName];
              const initialVal = isCheck
                ? (ann.fieldValue && ann.fieldValue !== 'Off' ? true : Boolean(fallbackVal))
                : (ann.fieldValue || fallbackVal || '');

              existingItems.push({
                id: `acro_${pageNum}_${ann.id || Math.random().toString(36).slice(2, 7)}`,
                type: 'acroform',
                fieldName: fName,
                fieldType: isCheck ? 'checkbox' : 'text',
                value: initialVal,
                x: left,
                y: top,
                width: Math.max(width, isCheck ? 18 : 60),
                height: Math.max(height, 18),
                fontSize: 11,
                fontFamily: 'Helvetica',
                color: '#0f172a'
              });
            }
            acroCount++;
          }
        });

        updateAcroformCountBadge();
      } catch (e) {
        console.warn('No se pudieron leer anotaciones AcroForm:', e);
      }
    }

    /**
     * Monta una capa de texto seleccionable y editable con doble clic sobre cada línea del PDF.
     * Permite:
     * 1. Seleccionar y copiar cualquier texto del PDF normalmente con el ratón.
     * 2. Hacer clic o doble clic sobre cualquier línea del PDF para convertirla al instante
     *    en un Parche Inteligente editable con el mismo color de papel de fondo.
     */
    async function mountInteractivePdfTextLayer(pdfPage, viewport, pageNum) {
      const overlay = document.querySelector(`.overlay-layer[data-page-number="${pageNum}"]`);
      if (!overlay) return;

      overlay.querySelectorAll('.pdf-text-layer').forEach((el) => el.remove());

      try {
        const textContent = await pdfPage.getTextContent();
        if (!textContent || !textContent.items || textContent.items.length === 0) return;

        const textLayerDiv = document.createElement('div');
        textLayerDiv.className = 'pdf-text-layer';

        textContent.items.forEach((item) => {
          const textStr = (item.str || '').trim();
          if (!textStr) return;

          const tx = window.pdfjsLib.Util.transform(viewport.transform, item.transform);
          const fontHeight = Math.max(10, Math.hypot(tx[2], tx[3]));
          const left = tx[4];
          const top = tx[5] - fontHeight * 0.88;
          const width = Math.max(24, (item.width || 40) * AppState.scale);
          const height = Math.max(14, fontHeight * 1.18);

          const span = document.createElement('span');
          span.className = 'pdf-text-hit';
          span.textContent = item.str;
          span.title = 'Selecciona para copiar, o haz doble clic para editar este texto directamente';
          span.style.left = `${Math.round(left)}px`;
          span.style.top = `${Math.round(top)}px`;
          span.style.width = `${Math.round(width)}px`;
          span.style.height = `${Math.round(height)}px`;
          span.style.fontSize = `${Math.round(fontHeight * 0.92)}px`;

          // Al hacer doble clic (o clic con herramienta Parche), convierte la línea del PDF en un parche editable en el acto
          span.addEventListener('dblclick', (ev) => {
            ev.stopPropagation();
            convertPdfTextSpanIntoSmartPatch(pageNum, textStr, left, top, width, height, fontHeight);
          });

          span.addEventListener('click', (ev) => {
            if (AppState.activeTool === 'patch') {
              ev.stopPropagation();
              convertPdfTextSpanIntoSmartPatch(pageNum, textStr, left, top, width, height, fontHeight);
            }
          });

          textLayerDiv.appendChild(span);
        });

        overlay.insertBefore(textLayerDiv, overlay.firstChild);
      } catch (err) {
        console.warn('Error montando capa de texto interactiva:', err);
      }
    }

    function convertPdfTextSpanIntoSmartPatch(pageNum, initialText, left, top, width, height, fontHeight) {
      const padX = 4;
      const padY = 2;
      const x = Math.max(0, Math.round(left - padX));
      const y = Math.max(0, Math.round(top - padY));
      const w = Math.round(width + padX * 2 + 16);
      const h = Math.round(height + padY * 2);

      const sampledBg = sampleBorderColorFromCanvas(pageNum, x, y, w, h);
      const newPatch = {
        id: 'patch_inline_' + Date.now(),
        type: 'patch',
        text: initialText,
        x,
        y,
        width: w,
        height: h,
        fontFamily: 'Helvetica',
        fontSize: Math.max(10, Math.min(24, Math.round(fontHeight * 0.88))),
        fontWeight: 'normal',
        color: '#0f172a',
        bgColor: sampledBg,
        opacity: 0.95
      };

      AppState.overlaysByPage[pageNum].push(newPatch);
      selectItem(newPatch.id, pageNum, false);
      renderOverlayItemsForPage(pageNum);
      setActiveTool('select');
      showToast('Línea convertida en texto editable (fondo de papel igualado automáticamente).', 'success');
    }

