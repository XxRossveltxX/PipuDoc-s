    async function runTesseractOcrOnPage(pageNum) {
      await ensurePageWindowRendered(pageNum);
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      if (!wrapper) return [];
      const canvas = wrapper.querySelector('canvas');

      showToast(`Leyendo texto con OCR (spa+eng) en Página ${pageNum}...`, 'info');
      try {
        const result = await window.Tesseract.recognize(canvas, 'spa+eng');
        const lines = (result?.data?.lines || []).map((ln) => ({
          text: (ln.text || '').trim(),
          bbox: ln.bbox
        })).filter((ln) => ln.text.length > 0);

        AppState.ocrCacheByPage[pageNum] = lines;
        showToast(`OCR completado: ${lines.length} líneas reconocidas en Página ${pageNum}.`, 'success');
        return lines;
      } catch (err) {
        console.error('Error Tesseract OCR:', err);
        showToast('Aviso OCR: Usando extracción híbrida.', 'warn');
        return [];
      }
    }

    async function extractStructuredLinesFromPage(pageNum, forceOcr = false) {
      await ensurePageWindowRendered(pageNum);
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      const cssWidth = wrapper ? wrapper.clientWidth : 612;
      const cssHeight = wrapper ? wrapper.clientHeight : 792;

      if (!forceOcr && AppState.pdfJsDoc) {
        const page = await AppState.pdfJsDoc.getPage(pageNum);
        const viewport = page.getViewport({ scale: AppState.scale });
        const textContent = await page.getTextContent();

        if (textContent.items && textContent.items.length > 0) {
          const mappedItems = textContent.items.map((item) => {
            const tx = window.pdfjsLib.Util.transform(viewport.transform, item.transform);
            return {
              str: item.str.trim(),
              x: tx[4],
              y: tx[5] - (item.height || 10),
              width: (item.width || 40) * AppState.scale,
              height: (item.height || 12) * AppState.scale
            };
          }).filter((it) => it.str.length > 0);

          if (mappedItems.length > 0) {
            return groupTextItemsIntoLines(mappedItems);
          }
        }
      }

      const ocrLines = AppState.ocrCacheByPage[pageNum] || (await runTesseractOcrOnPage(pageNum));
      const canvas = wrapper ? wrapper.querySelector('canvas') : null;
      const ratioX = canvas ? cssWidth / canvas.width : 0.5;
      const ratioY = canvas ? cssHeight / canvas.height : 0.5;

      return ocrLines.map((ln) => ({
        y: ln.bbox.y0 * ratioY,
        text: ln.text,
        items: [{
          str: ln.text,
          x: ln.bbox.x0 * ratioX,
          y: ln.bbox.y0 * ratioY,
          width: (ln.bbox.x1 - ln.bbox.x0) * ratioX,
          height: (ln.bbox.y1 - ln.bbox.y0) * ratioY
        }]
      }));
    }

    function groupTextItemsIntoLines(items) {
      const sorted = [...items].sort((a, b) => a.y - b.y || a.x - b.x);
      const lines = [];
      const rowTolerance = 8;

      sorted.forEach((it) => {
        let line = lines.find((l) => Math.abs(l.y - it.y) <= rowTolerance);
        if (!line) {
          line = { y: it.y, items: [] };
          lines.push(line);
        }
        line.items.push(it);
      });

      lines.forEach((l) => {
        l.items.sort((a, b) => a.x - b.x);
        l.text = l.items.map((i) => i.str).join('   ');
      });

      return lines.sort((a, b) => a.y - b.y);
    }

    function estimateTableRowsAndColsFromCanvas(pageNum, domX, domY, domW, domH) {
      const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
      if (!wrapper) return { rows: 4, cols: 3 };
      const canvas = wrapper.querySelector('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      const rx = canvas.width / canvas.clientWidth;
      const ry = canvas.height / canvas.clientHeight;

      const x = Math.max(0, Math.floor(domX * rx));
      const y = Math.max(0, Math.floor(domY * ry));
      const w = Math.min(canvas.width - x, Math.max(20, Math.floor(domW * rx)));
      const h = Math.min(canvas.height - y, Math.max(20, Math.floor(domH * ry)));

      const img = ctx.getImageData(x, y, w, h).data;
      const rowInk = new Array(h).fill(0);
      const colInk = new Array(w).fill(0);

      for (let py = 0; py < h; py++) {
        for (let px = 0; px < w; px++) {
          const idx = (py * w + px) * 4;
          const lum = (img[idx] + img[idx + 1] + img[idx + 2]) / 3;
          if (lum < 200) {
            rowInk[py]++;
            colInk[px]++;
          }
        }
      }

      let rowBands = 0, inRow = false;
      for (let py = 0; py < h; py++) {
        const active = rowInk[py] > w * 0.03;
        if (active && !inRow) { rowBands++; inRow = true; }
        else if (!active) { inRow = false; }
      }

      let colBands = 0, inCol = false;
      for (let px = 0; px < w; px++) {
        const active = colInk[px] > h * 0.04;
        if (active && !inCol) { colBands++; inCol = true; }
        else if (!active) { inCol = false; }
      }

      return {
        rows: Math.max(2, Math.min(15, rowBands || 4)),
        cols: Math.max(2, Math.min(8, colBands || 3))
      };
    }

    async function buildDocxInspectionPreview(forceOcr = false) {
      const container = document.getElementById('docxPreviewBlocksContainer');
      const summaryEl = document.getElementById('docxAnalysisSummary');
      container.innerHTML = `<div class="p-4 text-xs text-slate-400 text-center">Analizando estructura de ${AppState.numPages} página(s)...</div>`;

      const blocks = [];
      let totalZonesUsed = 0;

      for (let p = 1; p <= AppState.numPages; p++) {
        const pageLines = await extractStructuredLinesFromPage(p, forceOcr);
        const manualZones = [...(AppState.zonesByPage[p] || [])].sort((a, b) => a.y - b.y);

        if (manualZones.length > 0) {
          totalZonesUsed += manualZones.length;
          for (const zone of manualZones) {
            if (zone.type === 'image') {
              const cropInfo = await cropZoneFromPageCanvas(p, zone);
              blocks.push({
                page: p,
                y: zone.y,
                kind: 'image',
                dataUrl: cropInfo.dataUrl,
                width: cropInfo.width,
                height: cropInfo.height,
                source: 'Zona Manual Morada'
              });
            } else if (zone.type === 'table') {
              const matrix = extractTableMatrixFromZone(pageLines, zone, p);
              blocks.push({
                page: p,
                y: zone.y,
                kind: 'table',
                rows: zone.rows || 4,
                cols: zone.cols || 3,
                matrix,
                source: 'Zona Manual Verde'
              });
            } else {
              const textLines = extractTextLinesInsideZone(pageLines, zone, p);
              blocks.push({
                page: p,
                y: zone.y,
                kind: 'text',
                lines: textLines,
                source: 'Zona Manual Azul'
              });
            }
          }
        } else {
          let idx = 0;
          while (idx < pageLines.length) {
            const ln = pageLines[idx];
            if (ln.items && ln.items.length >= 3) {
              const tableRows = [];
              while (idx < pageLines.length && pageLines[idx].items && pageLines[idx].items.length >= 2) {
                tableRows.push(pageLines[idx].items.map((i) => i.str));
                idx++;
              }
              blocks.push({
                page: p,
                y: ln.y,
                kind: 'table',
                rows: tableRows.length,
                cols: Math.max(...tableRows.map((r) => r.length)),
                matrix: tableRows,
                source: 'Detección Automática'
              });
            } else {
              blocks.push({
                page: p,
                y: ln.y,
                kind: 'text',
                lines: [ln.text],
                source: 'Detección Automática'
              });
              idx++;
            }
          }

          const userItems = (AppState.overlaysByPage[p] || []).filter((it) => it.type === 'patch' || it.type === 'text' || it.type === 'acroform');
          userItems.forEach((uit) => {
            const val = uit.type === 'acroform' ? `${uit.fieldName}: ${uit.value}` : uit.text;
            if (val) {
              blocks.push({
                page: p,
                y: uit.y,
                kind: 'text',
                lines: [val],
                source: `Campo Editado (${uit.type.toUpperCase()})`
              });
            }
          });
        }
      }

      AppState.lastDocxPreviewBlocks = blocks;
      summaryEl.textContent = totalZonesUsed > 0
        ? `Usando ${totalZonesUsed} Zona(s) Manual(es) ordenadas de arriba a abajo (${blocks.length} bloques).`
        : `Se detectaron ${blocks.length} bloques automáticamente. Si deseas separar tablas o imágenes manualmente, pulsa el botón amarillo abajo.`;

      renderDocxPreviewBlocksUI(blocks);
    }

