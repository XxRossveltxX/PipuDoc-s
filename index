    function cropZoneFromPageCanvas(pageNum, zone) {
      return new Promise((resolve) => {
        const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pageNum}"]`);
        if (!wrapper) return resolve({ dataUrl: '', uint8Array: new Uint8Array(), width: 200, height: 100 });
        const canvas = wrapper.querySelector('canvas');
        const rx = canvas.width / canvas.clientWidth;
        const ry = canvas.height / canvas.clientHeight;

        const sx = Math.max(0, Math.floor(zone.x * rx));
        const sy = Math.max(0, Math.floor(zone.y * ry));
        const sw = Math.min(canvas.width - sx, Math.max(10, Math.floor(zone.width * rx)));
        const sh = Math.min(canvas.height - sy, Math.max(10, Math.floor(zone.height * ry)));

        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = sw;
        tempCanvas.height = sh;
        tempCanvas.getContext('2d').drawImage(canvas, sx, sy, sw, sh, 0, 0, sw, sh);

        const dataUrl = tempCanvas.toDataURL('image/png');
        tempCanvas.toBlob(async (blob) => {
          const buf = blob ? await blob.arrayBuffer() : new ArrayBuffer(0);
          resolve({
            dataUrl,
            uint8Array: new Uint8Array(buf),
            width: Math.round(zone.width),
            height: Math.round(zone.height)
          });
        }, 'image/png');
      });
    }

    function extractTextLinesInsideZone(pageLines, zone, pageNum) {
      const matched = [];
      pageLines.forEach((ln) => {
        const inY = ln.y >= zone.y - 12 && ln.y <= zone.y + zone.height + 12;
        if (inY && ln.items) {
          const subItems = ln.items.filter((it) => {
            const centerX = it.x + (it.width || 20) / 2;
            return centerX >= zone.x - 10 && centerX <= zone.x + zone.width + 10;
          });
          if (subItems.length > 0) {
            matched.push(subItems.map((i) => i.str).join(' '));
          }
        }
      });

      const overlays = AppState.overlaysByPage[pageNum] || [];
      overlays.forEach((ov) => {
        if ((ov.type === 'patch' || ov.type === 'text') && ov.y >= zone.y - 10 && ov.y <= zone.y + zone.height) {
          matched.push(ov.text);
        }
      });

      return matched.length > 0 ? matched : ['[Texto de zona extraído]'];
    }

    function extractTableMatrixFromZone(pageLines, zone, pageNum) {
      const rows = Math.max(1, zone.rows || 4);
      const cols = Math.max(1, zone.cols || 3);
      const matrix = Array.from({ length: rows }, () => Array.from({ length: cols }, () => ''));

      const cellW = zone.width / cols;
      const cellH = zone.height / rows;

      pageLines.forEach((ln) => {
        (ln.items || []).forEach((it) => {
          const cx = it.x + 4;
          const cy = it.y + 4;
          if (cx >= zone.x - 8 && cx <= zone.x + zone.width + 8 && cy >= zone.y - 8 && cy <= zone.y + zone.height + 8) {
            const rIdx = Math.min(rows - 1, Math.max(0, Math.floor((cy - zone.y) / cellH)));
            const cIdx = Math.min(cols - 1, Math.max(0, Math.floor((cx - zone.x) / cellW)));
            matrix[rIdx][cIdx] = (matrix[rIdx][cIdx] ? matrix[rIdx][cIdx] + ' ' : '') + it.str;
          }
        });
      });

      return matrix;
    }

    async function compileAndDownloadDocxFile() {
      if (!window.docx) {
        showToast('Librería docx no disponible.', 'error');
        return;
      }

      const {
        Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell,
        ImageRun, WidthType, HeadingLevel
      } = window.docx;

      if (AppState.lastDocxPreviewBlocks.length === 0) {
        await buildDocxInspectionPreview(false);
      }

      const children = [
        new Paragraph({
          heading: HeadingLevel.HEADING_1,
          children: [new TextRun({ text: `Documento Convertido: ${AppState.fileName}`, bold: true, size: 28 })]
        })
      ];

      const orderedBlocks = [...AppState.lastDocxPreviewBlocks].sort((a, b) => a.page - b.page || a.y - b.y);

      for (const block of orderedBlocks) {
        if (block.kind === 'image') {
          const base64Data = (block.dataUrl || '').split(',')[1] || '';
          const binaryStr = atob(base64Data);
          const bytes = new Uint8Array(binaryStr.length);
          for (let i = 0; i < binaryStr.length; i++) bytes[i] = binaryStr.charCodeAt(i);

          children.push(
            new Paragraph({
              children: [
                new ImageRun({
                  data: bytes,
                  transformation: {
                    width: Math.min(480, Math.max(80, block.width || 300)),
                    height: Math.min(600, Math.max(50, block.height || 160))
                  }
                })
              ]
            })
          );
        } else if (block.kind === 'table') {
          const colCount = Math.max(1, block.cols || (block.matrix?.[0]?.length || 2));
          const tableRows = (block.matrix || [['Celda']]).map((rowArr, rIdx) => {
            const cells = [];
            for (let c = 0; c < colCount; c++) {
              const cellText = rowArr[c] || '';
              cells.push(
                new TableCell({
                  width: { size: Math.floor(100 / colCount), type: WidthType.PERCENTAGE },
                  children: [
                    new Paragraph({
                      children: [
                        new TextRun({
                          text: cellText,
                          bold: rIdx === 0,
                          size: 20
                        })
                      ]
                    })
                  ]
                })
              );
            }
            return new TableRow({ children: cells });
          });

          children.push(
            new Table({
              width: { size: 100, type: WidthType.PERCENTAGE },
              rows: tableRows
            })
          );
          children.push(new Paragraph({ text: '' }));
        } else {
          (block.lines || []).forEach((lineText) => {
            children.push(
              new Paragraph({
                children: [new TextRun({ text: lineText, size: 22 })],
                spacing: { after: 120 }
              })
            );
          });
        }
      }

      const doc = new Document({
        sections: [{ properties: {}, children }]
      });

      const blob = await Packer.toBlob(doc);
      const outName = AppState.fileName.replace(/\.[^/.]+$/, '') + '_Convertido.docx';
      window.saveAs(blob, outName);
      showToast(`Archivo Word "${outName}" descargado exitosamente.`, 'success');
    }

