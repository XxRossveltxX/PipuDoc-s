    function makeElementDraggableAndResizable(el, resizeHandle, dataObj, pageNum, isZone) {
      let mode = null;
      let startClientX = 0, startClientY = 0;
      let origX = 0, origY = 0, origW = 0, origH = 0;

      resizeHandle.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
        selectItem(dataObj.id, pageNum, isZone);
        mode = 'resize';
        startClientX = e.clientX;
        startClientY = e.clientY;
        origW = dataObj.width;
        origH = dataObj.height;
        resizeHandle.setPointerCapture(e.pointerId);
      });

      resizeHandle.addEventListener('pointermove', (e) => {
        if (mode !== 'resize') return;
        dataObj.width = Math.max(28, Math.round(origW + (e.clientX - startClientX)));
        dataObj.height = Math.max(18, Math.round(origH + (e.clientY - startClientY)));
        el.style.width = `${dataObj.width}px`;
        el.style.height = `${dataObj.height}px`;
      });

      resizeHandle.addEventListener('pointerup', (e) => {
        if (mode === 'resize') {
          mode = null;
          if (resizeHandle.hasPointerCapture(e.pointerId)) resizeHandle.releasePointerCapture(e.pointerId);
        }
      });

      el.addEventListener('pointerdown', (e) => {
        if (e.target === resizeHandle) return;
        selectItem(dataObj.id, pageNum, isZone);
        if (e.target.isContentEditable || e.target.tagName === 'INPUT') return;

        mode = 'drag';
        startClientX = e.clientX;
        startClientY = e.clientY;
        origX = dataObj.x;
        origY = dataObj.y;
        el.setPointerCapture(e.pointerId);
      });

      el.addEventListener('pointermove', (e) => {
        if (mode !== 'drag') return;
        const parent = el.parentElement;
        const maxW = parent ? parent.clientWidth - dataObj.width : 800;
        const maxH = parent ? parent.clientHeight - dataObj.height : 1000;
        dataObj.x = Math.max(0, Math.min(maxW, Math.round(origX + (e.clientX - startClientX))));
        dataObj.y = Math.max(0, Math.min(maxH, Math.round(origY + (e.clientY - startClientY))));
        el.style.left = `${dataObj.x}px`;
        el.style.top = `${dataObj.y}px`;
      });

      el.addEventListener('pointerup', (e) => {
        if (mode === 'drag') {
          mode = null;
          if (el.hasPointerCapture(e.pointerId)) el.releasePointerCapture(e.pointerId);
        }
      });
    }

    function selectItem(itemId, pageNum, isZone) {
      AppState.selectedItemId = itemId;
      AppState.selectedItemPage = pageNum;
      AppState.selectedIsZone = isZone;
      refreshAllSelectionsUI();
      updateInspectorUI();
