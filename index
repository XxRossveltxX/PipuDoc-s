    async function exportFinalPdfDocument() {
      const flattenSecurity = document.getElementById('chkFlattenSecurity').checked;
      const outFilename = (document.getElementById('exportPdfFilename').value || 'Documento_Exportado.pdf').trim();

      showToast(
        flattenSecurity
          ? 'Generando PDF Blindado (Fusionando firmas, parches y campos en capa de seguridad)...'
          : 'Exportando PDF vectorial...',
        'info'
      );

      try {
        const { PDFDocument, StandardFonts, rgb } = window.PDFLib;

        if (flattenSecurity) {
          const flattenedPdf = await PDFDocument.create();

          for (let p = 1; p <= AppState.numPages; p++) {
            await ensurePageWindowRendered(p);
            const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${p}"]`);
            const baseCanvas = wrapper.querySelector('canvas');

            const compositeCanvas = document.createElement('canvas');
            compositeCanvas.width = baseCanvas.width;
            compositeCanvas.height = baseCanvas.height;
            const cCtx = compositeCanvas.getContext('2d');

            cCtx.drawImage(baseCanvas, 0, 0);

            const ratioX = compositeCanvas.width / baseCanvas.clientWidth;
            const ratioY = compositeCanvas.height / baseCanvas.clientHeight;

            const items = AppState.overlaysByPage[p] || [];
            for (const item of items) {
              const cx = item.x * ratioX;
              const cy = item.y * ratioY;
              const cw = item.width * ratioX;
              const ch = item.height * ratioY;

              if (item.type === 'patch' || item.type === 'acroform') {
                cCtx.fillStyle = item.type === 'patch' ? (item.bgColor || '#ffffff') : '#ffffff';
                cCtx.fillRect(cx, cy, cw, ch);
              }

              if (item.type === 'patch' || item.type === 'text' || item.type === 'acroform') {
                const textVal = item.type === 'acroform'
                  ? (item.fieldType === 'checkbox' ? (item.value ? '☑' : '☐') : String(item.value || ''))
                  : String(item.text || '');

                cCtx.save();
                cCtx.globalAlpha = item.opacity ?? 0.95;
                cCtx.fillStyle = item.color || '#0f172a';
                const fSize = Math.round((item.fontSize || 12) * ratioY);
                const weight = item.fontWeight === 'bold' ? 'bold ' : '';
                cCtx.font = `${weight}${fSize}px ${item.fontFamily || 'Helvetica'}, sans-serif`;
                cCtx.textBaseline = 'middle';
                cCtx.fillText(textVal, cx + 6 * ratioX, cy + ch / 2);
                cCtx.restore();
              }

              if ((item.type === 'signature' || item.type === 'stamp-profile') && item.dataUrl) {
                await new Promise((res) => {
                  const img = new Image();
                  img.onload = () => {
                    cCtx.drawImage(img, cx, cy, cw, ch);
                    res();
                  };
                  img.onerror = res;
                  img.src = item.dataUrl;
                });
              }
            }

            const jpegDataUrl = compositeCanvas.toDataURL('image/jpeg', 0.94);
            const embeddedJpg = await flattenedPdf.embedJpg(jpegDataUrl);
            const pdfPage = flattenedPdf.addPage([612, 792]);
            pdfPage.drawImage(embeddedJpg, { x: 0, y: 0, width: 612, height: 792 });
          }

          const finalBytes = await flattenedPdf.save();
          const blob = new Blob([finalBytes], { type: 'application/pdf' });
          window.saveAs(blob, outFilename);
          showToast(`PDF Blindado "${outFilename}" descargado correctamente.`, 'success');
          return;
        }

        // Modo vectorial con matemática cartesiana exacta
        const pdfDoc = await PDFDocument.load(AppState.pdfBytes);
        const fontMap = {
          'Helvetica': await pdfDoc.embedFont(StandardFonts.Helvetica),
          'Helvetica-Bold': await pdfDoc.embedFont(StandardFonts.HelveticaBold),
          'Times-Roman': await pdfDoc.embedFont(StandardFonts.TimesRoman),
          'Courier': await pdfDoc.embedFont(StandardFonts.Courier)
        };

        const pages = pdfDoc.getPages();

        for (let idx = 0; idx < pages.length; idx++) {
          const pNum = idx + 1;
          const pdfPage = pages[idx];
          const { width: pdfPageWidth, height: pdfPageHeight } = pdfPage.getSize();

          const wrapper = document.querySelector(`.pdf-page-wrapper[data-page-number="${pNum}"]`);
          const canvasEl = wrapper ? wrapper.querySelector('canvas') : null;
          const canvasClientWidth = (canvasEl && canvasEl.clientWidth) ? canvasEl.clientWidth : (wrapper ? wrapper.clientWidth : pdfPageWidth);
          const canvasClientHeight = (canvasEl && canvasEl.clientHeight) ? canvasEl.clientHeight : (wrapper ? wrapper.clientHeight : pdfPageHeight);

          const scaleX = pdfPageWidth / canvasClientWidth;
          const scaleY = pdfPageHeight / canvasClientHeight;

          const items = AppState.overlaysByPage[pNum] || [];
          for (const item of items) {
            const domX = item.x;
            const domY = item.y;
            const domWidth = item.width;
            const domHeight = item.height;

            const pdfX = domX * scaleX;
            const pdfY = pdfPageHeight - ((domY + domHeight) * scaleY);
            const pdfW = domWidth * scaleX;
            const pdfH = domHeight * scaleY;

            if (item.type === 'patch' || item.type === 'acroform') {
              const bg = hexToRgbNormalized(item.type === 'patch' ? (item.bgColor || '#ffffff') : '#ffffff');
              pdfPage.drawRectangle({
                x: pdfX,
                y: pdfY,
                width: pdfW,
                height: pdfH,
                color: rgb(bg.r, bg.g, bg.b)
              });
            }

            if (item.type === 'patch' || item.type === 'text' || item.type === 'acroform') {
              const textVal = item.type === 'acroform'
                ? (item.fieldType === 'checkbox' ? (item.value ? 'X' : '') : String(item.value || ''))
                : String(item.text || '');

              if (textVal) {
                const fg = hexToRgbNormalized(item.color || '#0f172a');
                const fontKey = item.fontWeight === 'bold' && item.fontFamily === 'Helvetica'
                  ? 'Helvetica-Bold'
                  : (fontMap[item.fontFamily] ? item.fontFamily : 'Helvetica');
                const fSize = (item.fontSize || 12) * scaleY;

                pdfPage.drawText(textVal, {
                  x: pdfX + 4 * scaleX,
                  y: pdfY + Math.max(3, (pdfH - fSize) / 2),
                  size: fSize,
                  font: fontMap[fontKey],
                  color: rgb(fg.r, fg.g, fg.b),
                  opacity: item.opacity ?? 0.95
                });
              }
            }

            if ((item.type === 'signature' || item.type === 'stamp-profile') && item.dataUrl) {
              const pngEmbed = await pdfDoc.embedPng(item.dataUrl);
              pdfPage.drawImage(pngEmbed, { x: pdfX, y: pdfY, width: pdfW, height: pdfH });
            }
          }
        }

        try { pdfDoc.getForm().flatten(); } catch (e) {}

        const outBytes = await pdfDoc.save();
        const blob = new Blob([outBytes], { type: 'application/pdf' });
        window.saveAs(blob, outFilename);
        showToast(`PDF "${outFilename}" exportado correctamente.`, 'success');
      } catch (err) {
        console.error(err);
        showToast('Error al exportar PDF: ' + err.message, 'error');
      }
    }

