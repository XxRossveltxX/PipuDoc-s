    function getSelectedObject() {
      if (!AppState.selectedItemId || !AppState.selectedItemPage) return null;
      const list = AppState.selectedIsZone
        ? AppState.zonesByPage[AppState.selectedItemPage]
        : AppState.overlaysByPage[AppState.selectedItemPage];
      return (list || []).find((it) => it.id === AppState.selectedItemId) || null;
    }

    function deleteItemById(itemId, pageNum, isZone) {
      if (isZone) {
        AppState.zonesByPage[pageNum] = (AppState.zonesByPage[pageNum] || []).filter((z) => z.id !== itemId);
        renderZonesForPage(pageNum);
      } else {
        AppState.overlaysByPage[pageNum] = (AppState.overlaysByPage[pageNum] || []).filter((it) => it.id !== itemId);
        renderOverlayItemsForPage(pageNum);
      }
      if (AppState.selectedItemId === itemId) {
        AppState.selectedItemId = null;
        AppState.selectedItemPage = null;
        updateInspectorUI();
      }
