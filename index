<style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      overflow: hidden;
    }
    .pdf-text-layer {
      position: absolute;
      inset: 0;
      pointer-events: auto;
      z-index: 15;
    }
    .pdf-text-hit {
      position: absolute;
      cursor: text;
      user-select: text;
      -webkit-user-select: text;
      color: transparent;
      border-radius: 3px;
      transition: background-color 0.12s ease, outline 0.12s ease;
      line-height: 1;
      white-space: pre;
    }
    .pdf-text-hit::selection {
      background: rgba(99, 102, 241, 0.32);
      color: transparent;
    }
    .pdf-text-hit:hover {
      background-color: rgba(99, 102, 241, 0.10);
      outline: 1px dashed rgba(99, 102, 241, 0.55);
    }
    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(100, 116, 139, 0.45);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.75);
    }

    /* Page Container & Overlay Layer */
    .pdf-page-wrapper {
      position: relative;
      margin: 0 auto 24px auto;
      box-shadow: 0 18px 32px -8px rgba(0, 0, 0, 0.42), 0 4px 12px -2px rgba(0, 0, 0, 0.28);
      border-radius: 6px;
      background-color: #ffffff;
      transition: width 0.15s ease, height 0.15s ease;
    }
    .overlay-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: auto;
      overflow: hidden;
      border-radius: 6px;
    }

    /* Interactive Overlay Items */
    .overlay-item {
      position: absolute;
      cursor: move;
      transition: box-shadow 0.12s ease;
      touch-action: none;
    }
    .overlay-item.selected {
      outline: 2px solid #6366f1;
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25);
      z-index: 40 !important;
    }
    .resize-handle {
      position: absolute;
      width: 11px;
      height: 11px;
      background: #6366f1;
      border: 2px solid #ffffff;
      border-radius: 50%;
      right: -6px;
      bottom: -6px;
      cursor: nwse-resize;
      display: none;
      z-index: 50;
    }
    .overlay-item.selected .resize-handle {
      display: block;
    }
    .delete-badge {
      position: absolute;
      top: -10px;
      right: -10px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #ef4444;
      color: #fff;
      font-size: 11px;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0,0,0,0.3);
      z-index: 55;
    }
    .overlay-item.selected .delete-badge {
      display: flex;
    }

    /* Manual Bounding Box Zones (Module 4) */
    .zone-box {
      position: absolute;
      border-width: 2px;
      border-style: dashed;
      cursor: move;
      touch-action: none;
    }
    .zone-box.zone-image {
      border-color: #a855f7;
      background-color: rgba(168, 85, 247, 0.15);
    }
    .zone-box.zone-table {
      border-color: #10b981;
      background-color: rgba(16, 185, 129, 0.15);
    }
    .zone-box.zone-text {
      border-color: #3b82f6;
      background-color: rgba(59, 130, 246, 0.15);
    }
    .zone-label-pill {
      position: absolute;
      top: -21px;
      left: -2px;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px 4px 0 0;
      color: #ffffff;
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 4px;
      pointer-events: auto;
    }

    /* Selection rubberband rectangle while drawing */
    .drawing-marquee {
      position: absolute;
      border: 2px dashed #6366f1;
      background: rgba(99, 102, 241, 0.16);
      pointer-events: none;
      z-index: 60;
    }

    /* Checkerboard background for transparent signature preview */
    .bg-checkerboard {
      background-image:
        linear-gradient(45deg, #cbd5e1 25%, transparent 25%),
        linear-gradient(-45deg, #cbd5e1 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #cbd5e1 75%),
        linear-gradient(-45deg, transparent 75%, #cbd5e1 75%);
      background-size: 14px 14px;
      background-position: 0 0, 0 7px, 7px -7px, -7px 0;
    }
    .dark .bg-checkerboard {
      background-image:
        linear-gradient(45deg, #1e293b 25%, transparent 25%),
        linear-gradient(-45deg, #1e293b 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #1e293b 75%),
        linear-gradient(-45deg, transparent 75%, #1e293b 75%);
    }
  </style>
