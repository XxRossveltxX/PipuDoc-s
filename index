      const form = pdfDoc.getForm();

      page1.drawText('Cliente / Empresa:', { x: 40, y: 654, size: 9.5, font: fontRegular, color: rgb(0.22, 0.25, 0.3) });
      const fieldCompany = form.createTextField('razon_social');
